# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/JKcafe?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - your deployed frontend URL(s), comma separated
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# Email notifications (Gmail example - use an App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
NOTIFY_EMAIL=franchise@jkchaatcafe.com

# Default admin (used only by seed.js / resetAdminPassword.js)
ADMIN_EMAIL=admin@jkchaatcafe.com
ADMIN_PASSWORD=ChangeThisPassword123!
